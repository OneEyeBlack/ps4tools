procedure TFormMain.btnImportLeftClick(Sender: TObject);
var
  LeftIP, SaveFolder: string;
begin
  btnStartImportClick(Sender);
  Exit;

  LeftIP := Trim(edtIpLeft.Text);
  if (LeftIP = '') or (cmbUserLeft.ItemIndex < 0) then
  begin
    ShowLocalizedMessage('Informe o IP e selecione o usuario de origem.');
    Exit;
  end;

  SaveFolder := TPath.Combine(ExtractFileDir(ParamStr(0)), 'saves');
  if not TDirectory.Exists(SaveFolder) then
    System.SysUtils.ForceDirectories(SaveFolder);
  if not SelectDirectory('Selecione o save para importar', SaveFolder, SaveFolder) then
    Exit;

  if MessageDlg('Os saves encontrados nesta pasta serao importados para o usuario de origem. Deseja continuar?',
    mtConfirmation, [mbYes, mbNo], 0) <> mrYes then Exit;
  RunWorker(
    procedure begin ImportPS4SaveBackup(LeftIP,
      FLeftUsers[cmbUserLeft.ItemIndex].UserID, SaveFolder,
      IsAutomaticSyncMode, AddLog); end,
    procedure
    begin
      AddLog('Importacao concluida para o PS4 de origem.');
      if cmbUserLeft.ItemIndex >= 0 then
        LoadLeftSavesForSelectedUser;
    end,
    'Falha ao importar saves: ');
end;

