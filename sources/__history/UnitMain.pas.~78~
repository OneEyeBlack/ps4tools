function TFormMain.IsValidUserID(const AUserID: string): Boolean;
var
  S: string;
  I: Integer;
begin
  S := LowerCase(Trim(AUserID));
  Result := (Length(S) = 8) and (S <> '.') and (S <> '..');
  if not Result then Exit;

  for I := 1 to Length(S) do
    if not CharInSet(S[I], ['0'..'9', 'a'..'f']) then
      Exit(False);
end;

procedure TFormMain.AppendValidUser(var AUsers: TArray<TPS4SaveUser>;
  const AUser: TPS4SaveUser);
begin
  if not IsValidUserID(AUser.UserID) then Exit;

  SetLength(AUsers, Length(AUsers) + 1);
  AUsers[High(AUsers)] := AUser;
end;

procedure TFormMain.FillSaveList(AList: TCheckListBox;
  const ASaves: TArray<TPS4SaveGame>; const AUserID: string;
  var AViewSaves: TArray<TPS4SaveGame>; AChecked: Boolean);
var
  I: Integer;
begin
  SetLength(AViewSaves, 0);
  AList.Items.BeginUpdate;
  try
    AList.Items.Clear;
    for I := 0 to High(ASaves) do
    begin
      if not SameText(ASaves[I].UserID, AUserID) then Continue;
      SetLength(AViewSaves, Length(AViewSaves) + 1);
      AViewSaves[High(AViewSaves)] := ASaves[I];
      AList.Items.Add(PS4SaveDisplayText(ASaves[I]));
      AList.Checked[AList.Items.Count - 1] := AChecked;
    end;
  finally
    AList.Items.EndUpdate;
  end;
end;

function TFormMain.TryFindDestSave(const ASave: TPS4SaveGame;
  out ADestSave: TPS4SaveGame): Boolean;
var
  I: Integer;
begin
  Result := False;
  for I := 0 to High(FDestViewSaves) do
    if SameText(FDestViewSaves[I].TitleID, ASave.TitleID) and
       SameText(FDestViewSaves[I].SaveName, ASave.SaveName) then
    begin
      ADestSave := FDestViewSaves[I];
      Exit(True);
    end;
end;

function TFormMain.IsNewLeftSave(AIndex: Integer): Boolean;
var
  DestSave: TPS4SaveGame;
begin
  Result := False;
  if not FDestSavesLoaded then Exit;
  if (AIndex < 0) or (AIndex > High(FViewSaves)) then Exit;

  if not TryFindDestSave(FViewSaves[AIndex], DestSave) then
    Exit(True);

  Result := FViewSaves[AIndex].ModifiedAt > DestSave.ModifiedAt;
end;

