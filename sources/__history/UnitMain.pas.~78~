procedure TFormMain.InitializeLanguageCombo;
var
  LLanguage: TAppLanguage;
begin
  cmbLanguage.Items.BeginUpdate;
  try
    cmbLanguage.Items.Clear;
    for LLanguage := Low(TAppLanguage) to High(TAppLanguage) do
      cmbLanguage.Items.Add(LanguageName(LLanguage));
    if cmbLanguage.ItemIndex < Ord(Low(TAppLanguage)) then
      cmbLanguage.ItemIndex := Ord(alPortugueseBrazil);
  finally
    cmbLanguage.Items.EndUpdate;
  end;
  FCurrentLanguage := TAppLanguage(cmbLanguage.ItemIndex);
end;

