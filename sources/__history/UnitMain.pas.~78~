procedure TFormMain.btnLoadUsersClick(Sender: TObject);
var
  LeftIP, DestIP: string;
  LoadedLeftUsers: TArray<TPS4SaveUser>;
  LoadedDestUsers: TArray<TPS4SaveUser>;
begin
  LeftIP := Trim(edtIpLeft.Text);
  DestIP := Trim(edtIpRight.Text);
  if (LeftIP = '') or (DestIP = '') then
  begin
    ShowLocalizedMessage('Informe o IP de origem e o IP de destino.');
    Exit;
  end;

  FLoadingUsers := True;
  cmbUserLeft.Enabled := False;
  cmbUserRight.Enabled := False;
  UpdateSideEnabled(True, False);
  UpdateSideEnabled(False, False);
  cmbUserLeft.Items.Clear;
  cmbUserRight.Items.Clear;
  cmbUserLeft.ItemIndex := -1;
  cmbUserRight.ItemIndex := -1;
  SetLength(FLeftUsers, 0);
  SetLength(FDestUsers, 0);
  SetLength(FSaves, 0);
  SetLength(FViewSaves, 0);
  SetLength(FDestSaves, 0);
  SetLength(FDestViewSaves, 0);
  SetLength(FTrophiesLeft, 0);
  SetLength(FTrophiesRight, 0);
  FDestSavesLoaded := False;
  FLeftUserActivated := False;
  FDestUserActivated := False;
  FLoadedLeftIP := '';
  FLoadedLeftUserID := '';
  clbSavesLeft.Items.Clear;
  clbSavesRight.Items.Clear;
  lvLeft.Items.BeginUpdate;
  lvRight.Items.BeginUpdate;
  try
    lvLeft.Items.Clear;
    lvRight.Items.Clear;
  finally
    lvRight.Items.EndUpdate;
    lvLeft.Items.EndUpdate;
  end;
  lvLeft.Invalidate;
  lvRight.Invalidate;

  RunWorker(
    procedure
    begin
      AddLog('Verificando PS4 Save Agent na origem...');
      try
        EnsurePS4SaveAgentCurrent(LeftIP, AddLog);
      except
        on E: Exception do
          AddLog('Atualizacao do PS4 Save Agent na origem nao concluida: ' +
            E.Message + '. Continuando com o Agent atual.');
      end;
      AddLog('Verificando PS4 Save Agent no destino...');
      try
        EnsurePS4SaveAgentCurrent(DestIP, AddLog);
      except
        on E: Exception do
          AddLog('Atualizacao do PS4 Save Agent no destino nao concluida: ' +
            E.Message + '. Continuando com o Agent atual.');
      end;
      AddLog('Carregando usuarios do PS4 de origem...');
      try
        LoadedLeftUsers := ListPS4Users(LeftIP, PS4_FTP_PORT);
      except
        on E: Exception do
        begin
          LoadedLeftUsers := nil;
          AddLog('Falha ao conectar/carregar origem: ' + E.Message);
        end;
      end;

      AddLog('Carregando usuarios do PS4 de destino...');
      try
        LoadedDestUsers := ListPS4Users(DestIP, PS4_FTP_PORT);
      except
        on E: Exception do
        begin
          LoadedDestUsers := nil;
          AddLog('Falha ao conectar/carregar destino: ' + E.Message);
        end;
      end;
    end,
    procedure
    var
      User: TPS4SaveUser;
    begin
      SetLength(FLeftUsers, 0);
      for User in LoadedLeftUsers do
        AppendValidUser(FLeftUsers, User);

      SetLength(FDestUsers, 0);
      for User in LoadedDestUsers do
        AppendValidUser(FDestUsers, User);

      cmbUserLeft.Items.BeginUpdate;
      try
        cmbUserLeft.Items.Clear;
        for User in FLeftUsers do
          cmbUserLeft.Items.Add(Format('%s (%s)', [User.DisplayName, User.UserID]));
        cmbUserLeft.ItemIndex := -1;
      finally
        cmbUserLeft.Items.EndUpdate;
      end;

      cmbUserRight.Items.BeginUpdate;
      try
        cmbUserRight.Items.Clear;
        for User in FDestUsers do
          cmbUserRight.Items.Add(Format('%s (%s)', [User.DisplayName, User.UserID]));
        cmbUserRight.ItemIndex := -1;
      finally
        cmbUserRight.Items.EndUpdate;
      end;

      cmbUserLeft.Enabled := Length(FLeftUsers) > 0;
      cmbUserRight.Enabled := Length(FDestUsers) > 0;
      cmbSyncMode.Enabled := True;
      UpdateUserDependentEnabled;
      SetAvatarControlsEnabled(cmbUserRight.ItemIndex >= 0);

      AddLog(Format('%d usuario(s) na origem, %d usuario(s) no destino.',
        [Length(FLeftUsers), Length(FDestUsers)]));
    end,
    'Falha ao carregar usuarios: ',
    procedure
    begin
      FLoadingUsers := False;
    end);
end;

procedure TFormMain.LoadLeftSavesForSelectedUser;
var
  LeftIP, LeftUserID: string;
  LoadedSaves: TArray<TPS4SaveGame>;
begin
  LeftIP := Trim(edtIpLeft.Text);
  if LeftIP = '' then
  begin
    ShowLocalizedMessage('Informe o IP de origem.');
    Exit;
  end;
  if cmbUserLeft.ItemIndex < 0 then
  begin
    ShowLocalizedMessage('Carregue e selecione o usuario de origem.');
    Exit;
  end;
  LeftUserID := FLeftUsers[cmbUserLeft.ItemIndex].UserID;
  if not IsValidUserID(LeftUserID) then
  begin
    ShowLocalizedMessage('Usuario de origem invalido: ' + LeftUserID);
    Exit;
  end;

  SetLength(FSaves, 0);
  SetLength(FViewSaves, 0);
  FLoadedLeftIP := '';
  FLoadedLeftUserID := '';
  clbSavesLeft.Items.Clear;

  RunWorker(
    procedure
    begin
      AddLog('Carregando SAVES de ' + LeftIP + ' usuario ' + LeftUserID + '...');
      LoadedSaves := ListPS4SaveGamesForUser(LeftIP, PS4_FTP_PORT, LeftUserID);
    end,
    procedure
    begin
      FSaves := LoadedSaves;
      FLoadedLeftIP := LeftIP;
      FLoadedLeftUserID := LeftUserID;
      FillSaveList(clbSavesLeft, FSaves, LeftUserID, FViewSaves, False);
      AddLog(Format('%d save(s) encontrado(s) para o usuario %s.', [Length(FViewSaves), LeftUserID]));
      clbSavesLeft.Invalidate;
      if cbOperationMode.ItemIndex = 0 then
        ValidateDestUserAndLoadSaves;
    end,
    'Falha ao carregar SAVES de origem: ');
end;

procedure TFormMain.LoadDestSavesForSelectedUser;
var
  DestIP, DestUserID: string;
  LoadedSaves: TArray<TPS4SaveGame>;
begin
  DestIP := Trim(edtIpRight.Text);
  if DestIP = '' then
  begin
    ShowLocalizedMessage('Informe o IP de destino.');
    Exit;
  end;
  if cmbUserRight.ItemIndex < 0 then
  begin
    ShowLocalizedMessage('Carregue e selecione o usuario de destino.');
    Exit;
  end;
  DestUserID := FDestUsers[cmbUserRight.ItemIndex].UserID;
  if not IsValidUserID(DestUserID) then
  begin
    ShowLocalizedMessage('Usuario de destino invalido: ' + DestUserID);
    Exit;
  end;

  SetLength(FDestSaves, 0);
  SetLength(FDestViewSaves, 0);
  FDestSavesLoaded := False;
  clbSavesRight.Items.Clear;

  RunWorker(
    procedure
    begin
      AddLog('Carregando SAVES de destino ' + DestIP + ' usuario ' + DestUserID + '...');
      LoadedSaves := ListPS4SaveGamesForUser(DestIP, PS4_FTP_PORT, DestUserID);
    end,
    procedure
    begin
      FDestSaves := LoadedSaves;
      FillSaveList(clbSavesRight, FDestSaves, DestUserID, FDestViewSaves, False);
      FDestSavesLoaded := True;
      clbSavesRight.Invalidate;
      AddLog(Format('%d save(s) encontrado(s) no destino para o usuario %s.',
        [Length(FDestViewSaves), DestUserID]));
    end,
    'Falha ao carregar SAVES de destino: ');
end;

