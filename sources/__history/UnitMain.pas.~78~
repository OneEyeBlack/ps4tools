end;

procedure TFormMain.SetStatus(const AMsg: string);
begin
  if GetCurrentThreadId <> MainThreadID then
  begin
    TThread.Queue(nil,
      procedure
      begin
        if csDestroying in ComponentState then Exit;
        SetStatus(AMsg);
      end);
