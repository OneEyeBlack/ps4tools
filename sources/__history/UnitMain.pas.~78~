procedure TFormMain.AddLog(const AMsg: string);
begin
  if Trim(AMsg) = '' then
    Exit;
  if GetCurrentThreadId <> MainThreadID then
  begin
    TThread.Queue(nil,
      procedure
      begin
        if csDestroying in ComponentState then Exit;
        AddLog(AMsg);
      end);
    Exit;
  end;

  memLog.Lines.Add(FormatDateTime('hh:nn:ss', Now) + '  ' +
    TranslateText(AMsg, FCurrentLanguage));
  memLog.SelStart := memLog.GetTextLen;
  memLog.Perform(EM_SCROLLCARET, 0, 0);
  SetStatus(AMsg);
end;

procedure TFormMain.ShowLocalizedMessage(const AMessage: string);
