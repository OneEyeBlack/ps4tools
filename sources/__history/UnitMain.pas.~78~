end;

procedure TFormMain.UpdateSyncProgress(const AMsg: string;
  APosition, AMax: Int64);
var
  Percent: Integer;
begin
  if GetCurrentThreadId <> MainThreadID then
  begin
    TThread.Queue(nil,
      procedure
      begin
        if csDestroying in ComponentState then Exit;
        UpdateSyncProgress(AMsg, APosition, AMax);
      end);
    Exit;
  end;

  if AMax > 0 then
  begin
    pbSync.Style := pbstNormal;
    Percent := Round((APosition * 100) / AMax);
    if Percent < 0 then Percent := 0;
    if Percent > 100 then Percent := 100;
    pbSync.Position := Percent;
    SetStatus(Format('%s %d%%', [AMsg, Percent]));
  end
  else
  begin
    pbSync.Position := 0;
    SetStatus(AMsg);
  end;
end;

procedure TFormMain.ResetSyncProgress;
begin
  if GetCurrentThreadId <> MainThreadID then
  begin
    TThread.Queue(nil,
      procedure
      begin
        if csDestroying in ComponentState then Exit;
        ResetSyncProgress;
      end);
    Exit;
  end;

  pbSync.Style := pbstNormal;
  pbSync.Position := 0;
end;

procedure TFormMain.RunWorker(const AWork: TProc; const AOnSuccess: TProc;
  const AErrorPrefix: string; const AOnFinished: TProc);
var
  Worker: TThread;
begin
  SetBusy(True);
  SetStatus('Processando...');
  Worker := TThread.CreateAnonymousThread(
    procedure
    var
      ErrorMsg: string;
      Success: Boolean;
    begin
      ErrorMsg := '';
      Success := False;
      try
        AWork();
        Success := True;
      except
        on E: Exception do
          ErrorMsg := E.Message;
      end;

      TThread.Queue(nil,
        procedure
        begin
          if csDestroying in ComponentState then Exit;
          SetBusy(False);
          try
            if Success then
            begin
              if Assigned(AOnSuccess) then
                AOnSuccess();
            end
            else
            begin
              AddLog(AErrorPrefix + ErrorMsg);
              SetStatus(AErrorPrefix + ErrorMsg);
              ShowLocalizedMessage(AErrorPrefix + ErrorMsg);
            end;
          finally
            if Assigned(AOnFinished) then
              AOnFinished();
          end;
        end);
    end);
  Worker.FreeOnTerminate := True;
  Worker.Start;
end;

