procedure TFormMain.btnSavesStartSinkClick(Sender: TObject);
var
  LeftIP, DestIP: string;
  LeftUserID, DestUserID: string;
  DestUserText: string;
  Selected: TArray<TPS4SaveGame>;
  BackupRoot: string;
  SamePS4: Boolean;
  AutomaticMode: Boolean;
  I: Integer;
begin
  LeftIP := Trim(edtIpLeft.Text);
  DestIP := Trim(edtIpRight.Text);
  AutomaticMode := IsAutomaticSyncMode;

  if (LeftIP = '') or (DestIP = '') then
  begin
    ShowLocalizedMessage('Informe o IP de origem e o IP de destino.');
    Exit;
  end;
  if not SameText(LeftIP, FLoadedLeftIP) then
  begin
    ShowLocalizedMessage('Carregue os SAVES do IP de origem antes de iniciar a sincronia.');
    Exit;
  end;
  if cmbUserLeft.ItemIndex < 0 then
  begin
    ShowLocalizedMessage('Selecione o usuario de origem.');
    Exit;
  end;
  if cmbUserRight.ItemIndex < 0 then
  begin
    ShowLocalizedMessage('Selecione o usuario de destino.');
    Exit;
  end;
  if AutomaticMode and not FLeftUserActivated then
  begin
    ShowLocalizedMessage(ActivationHelpText(FLeftUsers[cmbUserLeft.ItemIndex].UserID));
    Exit;
  end;
  if AutomaticMode and not FDestUserActivated then
  begin
    ShowLocalizedMessage(ActivationHelpText(FDestUsers[cmbUserRight.ItemIndex].UserID));
    Exit;
  end;
  if not SameText(FLeftUsers[cmbUserLeft.ItemIndex].UserID, FLoadedLeftUserID) then
  begin
    ShowLocalizedMessage('Carregue os SAVES do usuario de origem selecionado antes de iniciar a sincronia.');
    Exit;
  end;
  if SameText(LeftIP, DestIP) and
     SameText(FLeftUsers[cmbUserLeft.ItemIndex].UserID, FDestUsers[cmbUserRight.ItemIndex].UserID) then
  begin
    ShowLocalizedMessage('No mesmo PS4, selecione usuarios diferentes para origem e destino.');
    Exit;
  end;
  LeftUserID := FLeftUsers[cmbUserLeft.ItemIndex].UserID;
  DestUserID := FDestUsers[cmbUserRight.ItemIndex].UserID;
  DestUserText := cmbUserRight.Items[cmbUserRight.ItemIndex];
  SamePS4 := SameText(LeftIP, DestIP);

  SetLength(Selected, 0);
  for I := 0 to clbSavesLeft.Items.Count - 1 do
    if clbSavesLeft.Checked[I] then
    begin
      SetLength(Selected, Length(Selected) + 1);
      Selected[High(Selected)] := FViewSaves[I];
    end;

  if Length(Selected) = 0 then
  begin
    ShowLocalizedMessage(TranslateSyncText('NeedGame', FCurrentLanguage));
    Exit;
  end;

  if not AutomaticMode then
  begin
    if MessageDlg(TranslateSyncText('ManualTitle', FCurrentLanguage, Length(Selected)) + sLineBreak + sLineBreak +
       TranslateSyncText('ManualBody', FCurrentLanguage),
       mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
      Exit;
  end
  else if not SamePS4 then
  begin
    if MessageDlg(TranslateSyncText('AgentTitle', FCurrentLanguage, Length(Selected)) + sLineBreak + sLineBreak +
       TranslateSyncText('AgentBody', FCurrentLanguage, 0, DestUserText),
       mtConfirmation, [mbYes, mbNo], 0) <> mrYes then
      Exit;
  end;

  BackupRoot := TPath.Combine(ExtractFileDir(ParamStr(0)), DECRYPTED_BACKUP_FOLDER);
  RunWorker(
    procedure
    begin
      ResetSyncProgress;
      if not AutomaticMode then
        SyncPS4Saves(LeftIP, DestIP, PS4_FTP_PORT, Selected, DestUserID, AddLog)
      else if SamePS4 then
        SyncPS4SavesOnConsole(LeftIP, LeftUserID, DestUserID, Selected, AddLog)
      else
        SyncPS4SavesDecrypted(LeftIP, DestIP, LeftUserID, DestUserID,
          Selected, BackupRoot, AddLog, UpdateSyncProgress);
    end,
    procedure
    begin
      UncheckAllSaves;
      if not AutomaticMode then
      begin
        AddLog(TranslateSyncText('ManualLog', FCurrentLanguage));
        ShowLocalizedMessage(TranslateSyncText('ManualDone', FCurrentLanguage));
      end
      else if SamePS4 then
      begin
        AddLog(TranslateSyncText('SameLog', FCurrentLanguage));
        LoadDestSavesForSelectedUser;
        ShowLocalizedMessage(TranslateSyncText('SameLog', FCurrentLanguage));
      end
      else
      begin
        AddLog(TranslateSyncText('AgentLog', FCurrentLanguage));
        LoadDestSavesForSelectedUser;
        ShowLocalizedMessage(TranslateSyncText('AgentDone', FCurrentLanguage, 0, '', BackupRoot));
      end;
    end,
    TranslateSyncText('SyncError', FCurrentLanguage));
end;

