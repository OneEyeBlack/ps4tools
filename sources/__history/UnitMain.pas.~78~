procedure TFormMain.ValidateLeftUserAndLoadSaves;
var
  LeftIP, LeftUserID, AccountID: string;
begin
  if cmbUserLeft.ItemIndex < 0 then
  begin
    ShowLocalizedMessage('Selecione o usuario do lado esquerdo.');
    Exit;
  end;
  if cmbUserLeft.ItemIndex < 0 then Exit;
  LeftIP := Trim(edtIpLeft.Text);
  LeftUserID := FLeftUsers[cmbUserLeft.ItemIndex].UserID;
  FLeftUserActivated := False;

  if not IsAutomaticSyncMode then
  begin
    FLeftUserActivated := True;
    LoadLeftSavesForSelectedUser;
    Exit;
  end;

  RunWorker(
    procedure
    begin
      AddLog('Validando Account ID do usuario origem ' + LeftUserID + '...');
      AccountID := GetPS4SaveAgentAccountID(LeftIP, LeftUserID, AddLog);
    end,
    procedure
    begin
      if SameText(AccountID, '0000000000000000') then
      begin
        AddLog('Usuario origem sem Account ID ativado: ' + LeftUserID);
        ShowLocalizedMessage(ActivationHelpText(LeftUserID));
        Exit;
      end;

      FLeftUserActivated := True;
      AddLog('Usuario origem ativado com Account ID ' + AccountID + '.');
      LoadLeftSavesForSelectedUser;
    end,
    'Falha ao validar usuario origem: ');
end;

