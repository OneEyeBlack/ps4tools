function LooksLikeAnyTitleID(const S: string): Boolean;
var
  LValue: string;
  I: Integer;
begin
  LValue := UpperCase(Trim(S));
  Result := Length(LValue) = 9;
  if not Result then
    Exit;
  for I := 1 to 4 do
    if not CharInSet(LValue[I], ['A'..'Z']) then
      Exit(False);
  for I := 5 to 9 do
    if not CharInSet(LValue[I], ['0'..'9']) then
      Exit(False);
end;

